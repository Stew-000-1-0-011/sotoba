#!/bin/bash

# chmod +xが必要

# ステージングされたファイルのうち、対象の拡張子(.c, .cpp, .h, .hpp)を抽出
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.(c|cpp|h|hpp)$")

if [ -n "$STAGED_FILES" ]; then
	# フォーマットを実行 (-i で上書き)
	echo "$STAGED_FILES" | xargs clang-format-20 -i

	# フォーマット後のファイルを再度ステージングする
	echo "$STAGED_FILES" | xargs git add
fi
