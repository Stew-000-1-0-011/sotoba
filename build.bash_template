# If editing `build.bash` is sufficient, do NOT edit `build.bash_template`!

set -eu

# clang
echo "build clang-debug" >&2
cmake -B clang_build/Debug/ -GNinja -DCMAKE_PREFIX_PATH=../install -DCMAKE_INSTALL_PREFIX=install -DCMAKE_CXX_COMPILER=clang++-20 -DCMAKE_BUILD_TYPE=Debug -DRELEASE_OPTIMIZE=-O2 -DBUILD_DEVS=ON
cmake --build clang_build/Debug/
cmake --build clang_build/Debug/ --target sotoba_examples
cmake --build clang_build/Debug/ --target sotoba_tests
cp ./clang_build/Debug/compile_commands.json .

echo "build clang-release" >&2
cmake -B clang_build/Release/ -GNinja -DCMAKE_PREFIX_PATH=../install -DCMAKE_INSTALL_PREFIX=install -DCMAKE_CXX_COMPILER=clang++-20 -DCMAKE_BUILD_TYPE=Release -DRELEASE_OPTIMIZE=-O2 -DBUILD_DEVS=ON
cmake --build clang_build/Release/
cmake --build clang_build/Release/ --target sotoba_examples
cmake --build clang_build/Release/ --target sotoba_tests

# gcc
echo "build gcc-debug" >&2
cmake -B gcc_build/Debug/ -GNinja -DCMAKE_PREFIX_PATH=../install -DCMAKE_INSTALL_PREFIX=install -DCMAKE_CXX_COMPILER=g++-14 -DCMAKE_BUILD_TYPE=Debug -DRELEASE_OPTIMIZE=-O2 -DBUILD_DEVS=ON
cmake --build gcc_build/Debug/
cmake --build gcc_build/Debug/ --target sotoba_examples
cmake --build gcc_build/Debug/ --target sotoba_tests

echo "build gcc-release" >&2
cmake -B gcc_build/Release/ -GNinja -DCMAKE_PREFIX_PATH=../install -DCMAKE_INSTALL_PREFIX=install -DCMAKE_CXX_COMPILER=g++-14 -DCMAKE_BUILD_TYPE=Release -DRELEASE_OPTIMIZE=-O2 -DBUILD_DEVS=ON
cmake --build gcc_build/Release/
cmake --build gcc_build/Release/ --target sotoba_examples
cmake --build gcc_build/Release/ --target sotoba_tests
